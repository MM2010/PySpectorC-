<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PySpector.Cli</RootNamespace>
    <AssemblyName>pyspector</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>pyspector</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PySpector.Core\PySpector.Core.csproj" />
    <ProjectReference Include="..\PySpector.Reporting\PySpector.Reporting.csproj" />
    <ProjectReference Include="..\PySpector.Plugins\PySpector.Plugins.csproj" />
  </ItemGroup>

</Project>
