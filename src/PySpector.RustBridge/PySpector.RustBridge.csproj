<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>PySpector.RustBridge</RootNamespace>
    <!-- Define RUST_BRIDGE constant conditionally -->
    <DefineConstants Condition="'$(Configuration)'=='Release'">$(DefineConstants);RUST_BRIDGE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PySpector.Core\PySpector.Core.csproj" />
  </ItemGroup>

</Project>
